/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' https://media.fluxixo.shop data:; font-src 'self'; media-src 'self' https://media.fluxixo.shop; connect-src 'self' https://cloudflareinsights.com https://fluxixo-autopilot.sayros2601.workers.dev; manifest-src 'self'; upgrade-insecure-requests

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8

/404
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex

/assets/fonts/*
  Cache-Control: public, max-age=2592000

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/thumbs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/pinterest/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/featured/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon-96x96.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon-192.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon-512.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sitemap-index.xml
