/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; upgrade-insecure-requests

/editor
  X-Robots-Tag: noindex, nofollow
/editor.html
  X-Robots-Tag: noindex, nofollow
/js/editor.js
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/css/editor.css
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8

/404
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex

/assets/fonts/*
  Cache-Control: public, max-age=2592000

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/originals/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/thumbs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sitemap-ru.xml
  Content-Type: application/xml; charset=utf-8

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
/pinterest-feed.csv
  Content-Type: text/csv; charset=utf-8
/social-feed.json
  Content-Type: application/json; charset=utf-8
